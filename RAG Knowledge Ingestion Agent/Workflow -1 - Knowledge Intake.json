      "name": "Webhook",
      "webhookId": "9346f3fb-c0c8-4270-8eb0-b99b0a85d42f"
    },
    {
      "parameters": {
        "jsCode": "// ===============================\n// Enterprise Knowledge Platform\n// Workflow 1 - Validate Request\n// Multi File Version\n// ===============================\n\nconst ALLOWED_EXTENSIONS = [\n  \"pdf\",\n  \"docx\",\n  \"doc\",\n  \"txt\",\n  \"md\",\n  \"html\"\n];\n\nconst MAX_FILE_SIZE = 50 * 1024 * 1024; // 50 MB\n\nconst item = $input.item;\n\n//--------------------------------------------------\n// Validate Binary Exists\n//--------------------------------------------------\n\nif (!item.binary || Object.keys(item.binary).length === 0) {\n    throw new Error(\"No document was uploaded.\");\n}\n\n//--------------------------------------------------\n// Validate Metadata\n//--------------------------------------------------\n\nconst body = item.json.body || {};\n\nconst department = body.Department;\nconst category = body.Category;\nconst version = body.Version;\nconst source = body.Source;\n\nif (!department) throw new Error(\"Department is required.\");\nif (!category) throw new Error(\"Category is required.\");\nif (!version) throw new Error(\"Version is required.\");\nif (!source) throw new Error(\"Source is required.\");\n\n//--------------------------------------------------\n// Validate Every Uploaded File\n//--------------------------------------------------\n\nconst binaryKeys = Object.keys(item.binary);\n\nfor (const key of binaryKeys) {\n\n    const file = item.binary[key];\n\n    if (!file.fileName) {\n        throw new Error(`${key}: Missing filename.`);\n    }\n\n    const extension = file.fileName\n        .split(\".\")\n        .pop()\n        .toLowerCase();\n\n    if (!ALLOWED_EXTENSIONS.includes(extension)) {\n        throw new Error(\n            `${file.fileName}: Unsupported file type (.${extension})`\n        );\n    }\n\n    const size = Number(file.fileSize || 0);\n\n    if (size <= 0) {\n        throw new Error(`${file.fileName}: Invalid file size.`);\n    }\n\n    if (size > MAX_FILE_SIZE) {\n        throw new Error(\n            `${file.fileName}: File exceeds 50 MB limit.`\n        );\n    }\n}\n\n//--------------------------------------------------\n// Success\n//--------------------------------------------------\n\nreturn [{\n    json: {\n        ...item.json,\n        total_files: binaryKeys.length,\n        validation_status: \"Passed\"\n    },\n    binary: item.binary\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -32,
        -48
      ],
      "id": "bff5ff67-c99b-41e6-b2f0-b3e6c2782a2c",
      "name": "Validate Request"
    },
    {
      "parameters": {
        "jsCode": "// ===============================================\n// Enterprise Knowledge Management Platform\n// Workflow 1 - Generate Document Metadata\n// ===============================================\n\nfunction generateUUID() {\n    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {\n        const r = Math.random() * 16 | 0;\n        const v = c === 'x' ? r : (r & 0x3 | 0x8);\n        return v.toString(16);\n    });\n}\n\nconst inputItem = $input.item;\n\nconst body = inputItem.json.body || {};\nconst binaries = inputItem.binary || {};\n\nconst output = [];\n\nfor (const binaryKey of Object.keys(binaries)) {\n\n    const file = binaries[binaryKey];\n\n    // ---------- File Information ----------\n\n    const fileName = file.fileName || \"\";\n    const extension = fileName.includes(\".\")\n        ? fileName.split(\".\").pop().toLowerCase()\n        : \"\";\n\n    const mimeType = file.mimeType || \"\";\n    const fileSize = file.bytes ?? 0;\n\n    // ---------- Generate UUID (Unique Per Document) ----------\n\n    const documentUUID = generateUUID();\n\n    // ---------- Build Output Item ----------\n\n    output.push({\n\n        json: {\n\n            // Document Identity\n            document_uuid: documentUUID,\n\n            // User Metadata\n            department: body.Department,\n            category: body.Category,\n            version: body.Version,\n            source: body.Source,\n\n            // File Metadata\n            file_name: fileName,\n            file_extension: extension,\n            mime_type: mimeType,\n            file_size: fileSize,\n\n            // Processing Metadata\n            processing_status: \"Uploaded\",\n            processing_stage: \"Intake\",\n            collection_name: \"knowledge_base\",\n\n            workflow_version: \"1.0\",\n\n            received_at: new Date().toISOString()\n\n        },\n\n        binary: {\n            file\n        }\n\n    });\n\n}\n\nreturn output;"
      },
      "type": "n8n-nodes-base.code",
